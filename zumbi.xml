<?xml version="1.0" encoding="UTF-8"?>
<!--
  Descritor da arvore da ISO (referencia / tool baseado em XML).

  NOTA: o fluxo recomendado e `make iso` (tools/build_iso.sh), que monta um
  staging validado em build/iso_root/ e chama `mkps2iso build/iso_root
  bin/zumbi.iso` (modo diretorio). Este XML fica como documentacao da arvore
  esperada e para tools que consomem descritor XML.

  Arvore esperada na raiz da ISO:
    SYSTEM.CNF            (obrigatorio — aponta para ZUMBI.ELF, CRLF)
    ZUMBI.ELF            (saida do `make`: bin/zumbi.elf)
    ASSETS/              (texturas, modelos, sons)
-->
<iso_project image_name="bin/zumbi.iso" volume_name="ZUMBI">
    <track type="data">
        <identifiers system="PLAYSTATION2" application="PLAYSTATION2"/>
        <directory_tree>
            <file name="SYSTEM.CNF" source="SYSTEM.CNF"/>
            <file name="ZUMBI.ELF"  source="bin/zumbi.elf"/>
            <dir name="ASSETS">
                <file name="*" source="assets/*"/>
            </dir>
        </directory_tree>
    </track>
</iso_project>
